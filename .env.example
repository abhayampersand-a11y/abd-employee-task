# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Neon POOLED connection — used by the running app (lib/prisma.ts).
# Host contains "-pooler". Add ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/taskflow?sslmode=require"

# Neon DIRECT connection — used by `prisma migrate` / `prisma studio` only.
# Same host WITHOUT "-pooler". Add ?sslmode=require.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/taskflow?sslmode=require"

# 32 random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Public base URL — used to build invite links (/invite/<token>).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
